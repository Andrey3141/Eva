class _V:
    __slots__ = ("x", "y", "z", "ring_i", "theta_j", "n_theta", "phi")
    def __init__(self, x, y, z, ring_i=None, theta_j=None,
                 n_theta=None, phi=None):
        self.x = x
        self.y = y
        self.z = z
        self.ring_i = ring_i
        self.theta_j = theta_j
        self.n_theta = n_theta
        self.phi = phi


# ============================================================
# ГЕОМЕТРИЯ: RAW SPHERE / BASE
# ============================================================
#
# ВАЖНО: топология полностью совпадает с
# bpy.ops.mesh.primitive_uv_sphere_add(segments=SEGMENTS,
# ring_count=RINGS):
#   * RINGS+1 параллелей (индексы i = 0..RINGS)
#   * phi = pi * i / RINGS, z = cos(phi)
#   * на i=0 и i=RINGS — по 1 вершине (полюс)
#   * на остальных i: n_theta = max(1, round(SEGMENTS * sin(phi)))
#   * theta_j = 2*pi*j / n_theta

def _ring_topology(segments=SEGMENTS, rings=RINGS):
    """Возвращает список (i, phi, n_theta) для каждой параллели."""
    topo = []
    for i in range(rings + 1):
        phi = math.pi * i / rings
        if i in (0, rings):
            n_theta = 1
        else:
            n_theta = max(1, int(round(segments * math.sin(phi))))
        topo.append((i, phi, n_theta))
    return topo


def _raw_sphere_positions(segments=SEGMENTS, rings=RINGS):
    """Исходная единичная UV-сфера с той же топологией, что в Blender."""
    verts = []
    for i, phi, n_theta in _ring_topology(segments, rings):
        z = math.cos(phi)
        r = math.sin(phi)
        for j in range(n_theta):
            u_theta = (2.0 * math.pi * j) / n_theta if n_theta > 0 else 0.0
            x = r * math.cos(u_theta)
            y = r * math.sin(u_theta)
            verts.append(_V(x, y, z, ring_i=i, theta_j=j,
                            n_theta=n_theta, phi=phi))
    return verts


def _base_vertex_positions(segments=SEGMENTS, rings=RINGS):
    """Чистая базовая геометрия без масок, та же топология, что в build_head."""
    verts = []
    hh = HEAD_HEIGHT * 0.5
    for i, phi, n_theta in _ring_topology(segments, rings):
        z = math.cos(phi)
        r = math.sin(phi)
        for j in range(n_theta):
            u_theta = (2.0 * math.pi * j) / n_theta if n_theta > 0 else 0.0
            x = r * math.cos(u_theta)
            y = r * math.sin(u_theta)

            z_norm = max(-1.0, min(1.0, z))
            full_w = _interp_width(z_norm)
            full_d = _interp_depth(z_norm)
            front_y = _interp_front(z_norm)

            half_w = min(full_w * 0.5, HEAD_WIDTH * 0.5)
            half_d = full_d * 0.5

            xx = x * half_w
            yy = y
            zz = z

            if yy >= 0:
                yy *= half_d * BACK_FLATNESS
            else:
                yy *= half_d * FACE_FLATNESS
                yy += front_y

            zz *= hh
            if z_norm < Z_CHIN_TOP:
                t = (Z_CHIN_TOP - z_norm) / (Z_CHIN_TOP - Z_CHIN_BOTTOM)
                zz -= CHIN_LENGTH * t

            if z_norm > Z_FOREHEAD:
                t = (z_norm - Z_FOREHEAD) / (Z_CROWN - Z_FOREHEAD)
                zz -= 0.008 * t

            verts.append(_V(xx, yy, zz, ring_i=i, theta_j=j,
                            n_theta=n_theta, phi=phi))

    base_depth_scale = HEAD_DEPTH / 0.290
    for v in verts:
        v.y *= base_depth_scale

    return verts


def _apply_stage(verts, stage_name, hh, hw):
    for name, fn in _STAGE_FUNCS:
        if name == stage_name:
            for v in verts:
                fn(v, hh, hw)
            return
    raise ValueError(f"Unknown stage: {stage_name}")


def _apply_all_stages(verts, hh, hw):
    for _, fn in _STAGE_FUNCS:
        for v in verts:
            fn(v, hh, hw)


