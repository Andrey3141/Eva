def _find_ring_index_by_z(z_target, verts_raw):
    """
    Находит индекс параллели в raw sphere, у которой z = cos(phi)
    ближе всего к z_target.
    """
    best_i = 0
    best_d = float("inf")
    for v in verts_raw:
        if v.n_theta == 1:  # полюса
            continue
        d = abs(v.z - z_target)
        if d < best_d:
            best_d = d
            best_i = v.ring_i
    return best_i


def _ring_phi_and_z(ring_i, rings=RINGS):
    phi = math.pi * ring_i / rings
    return phi, math.cos(phi)


