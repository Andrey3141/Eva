        w = _interp_zones(REF_ZONES, t, 1)
        d = _interp_zones(REF_ZONES, t, 2)
        f = _interp_zones(REF_ZONES, t, 3)
        ref.append({
            "z_t": t,
            "width": w,
            "depth": d,
            "front_local": -f * actual_front_scale,
