def debug_profile_sphere_base():
    """
    Точная проверка математической связи:

        WIDTH_PROFILE → UV sphere → фактическая ширина базового среза.

    Для контрольных z_norm печатает:
      * profile_width      = _interp_width(z_norm)
      * sphere_factor      = sqrt(max(0, 1 - z_norm^2))
      * expected_width     = profile_width * sphere_factor
      * actual_base_width  = фактическая ширина среза базовой головы
      * actual/profile
      * actual/expected

    actual_base_width измеряется по той же топологии, что создаёт
    Blender (RINGS+1 параллелей, n_theta = max(1, round(SEGMENTS*sin phi))).
    """
    base = _base_vertex_positions()
    base_slices = _slice_widths(base, num_slices=200)

    print()
    print("=== PROFILE → SPHERE → BASE WIDTH ===")
    print(f"{'z_norm':>8}"
          f"{'prof_w':>10}"
          f"{'sph_fac':>10}"
          f"{'exp_w':>10}"
          f"{'act_base_w':>13}"
          f"{'act/prof':>11}"
          f"{'act/exp':>10}")

    for z in DEBUG_Z_SAMPLES:
        pw = _interp_width(z)
        sf = math.sqrt(max(0.0, 1.0 - z * z))
        ew = pw * sf

        # Найти базовый срез с центром ближе всего к z
        base_best = min(base_slices, key=lambda s: abs(
            0.5 * (s["z_top"] + s["z_bot"]) - z))
        ab = base_best["width"]

        ratio_prof = ab / pw if pw > 1e-9 else 0.0
        ratio_exp = ab / ew if ew > 1e-9 else 0.0

        print(f"{z:>+8.2f}"
              f"{pw:>10.4f}"
              f"{sf:>10.4f}"
              f"{ew:>10.4f}"
              f"{ab:>13.4f}"
              f"{ratio_prof:>11.4f}"
              f"{ratio_exp:>10.4f}")

    print("=== END PROFILE → SPHERE → BASE WIDTH ===")
    print()


