def build_head(coll):
    """Строит голову — единый mesh."""
    mat_skin = make_material("Alesya_Skin", C.SKIN_COLOR,
                             roughness=0.55, specular=0.25)

    bpy.ops.mesh.primitive_uv_sphere_add(
        segments=SEGMENTS, ring_count=RINGS,
        location=(0, 0, C.HEAD_CENTER_Z), radius=1.0)
    head = bpy.context.active_object
    head.name = "Alesya_Head"

    hh = HEAD_HEIGHT * 0.5
    me = head.data

    for v in me.vertices:
        x, y, z = v.co.x, v.co.y, v.co.z

        z_norm = max(-1.0, min(1.0, z))

        full_w = _interp_width(z_norm)
        full_d = _interp_depth(z_norm)
        front_y = _interp_front(z_norm)

        half_w = min(full_w * 0.5, HEAD_WIDTH * 0.5)
        half_d = full_d * 0.5

        x *= half_w

        if y >= 0:
            y *= half_d * BACK_FLATNESS
        else:
            y *= half_d * FACE_FLATNESS
            y += front_y

        z *= hh
        if z_norm < Z_CHIN_TOP:
            t = (Z_CHIN_TOP - z_norm) / (Z_CHIN_TOP - Z_CHIN_BOTTOM)
            z -= CHIN_LENGTH * t

        if z_norm > Z_FOREHEAD:
            t = (z_norm - Z_FOREHEAD) / (Z_CROWN - Z_FOREHEAD)
            z -= 0.008 * t

        v.co.x = x
        v.co.y = y
        v.co.z = z

    base_depth_scale = HEAD_DEPTH / 0.290
    for v in me.vertices:
        v.co.y *= base_depth_scale

    for v in me.vertices:
        v.co.z += C.HEAD_CENTER_Z

    work_hw = HEAD_WIDTH * 0.5
    work_hh = HEAD_HEIGHT * 0.5

    for v in me.vertices:
        local_z = v.co.z - C.HEAD_CENTER_Z
        tmp = _V(v.co.x, v.co.y, local_z)
        for _, fn in _STAGE_FUNCS:
            fn(tmp, work_hh, work_hw)
        v.co.x = tmp.x
        v.co.y = tmp.y
        v.co.z = tmp.z + C.HEAD_CENTER_Z

    if APPLY_SHADE_SMOOTH:
        shade_smooth(head)

    assign_material(head, mat_skin)
    link_to_collection(head, coll)

    return head
