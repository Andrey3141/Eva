def _interp_zones(zones, t, idx):
    if t <= zones[0][0]:
        return zones[0][idx]
    if t >= zones[-1][0]:
        return zones[-1][idx]
    for i in range(len(zones) - 1):
        t0 = zones[i][0]
        t1 = zones[i + 1][0]
        if t0 <= t <= t1:
            k = (t - t0) / (t1 - t0) if t1 > t0 else 0.0
            return _lerp(zones[i][idx], zones[i + 1][idx], k)
    return zones[-1][idx]


def _clear_scene():
