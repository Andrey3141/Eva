def _apply_forehead(v, hh, hw):
    z_norm = v.z / hh
    w_z = _gauss(z_norm, FOREHEAD_Z_CENTER, FOREHEAD_Z_WIDTH)
    w_y = _smoothstep(0.0, FOREHEAD_Y_FRONT_MAX, v.y)
    w = w_z * w_y
    if abs(v.x) > 1e-6:
        v.x += math.copysign(FOREHEAD_X_AMP * w, v.x)


def _apply_brow(v, hh, hw):
    z_norm = v.z / hh
    w_z = _gauss(z_norm, BROW_Z_CENTER, BROW_Z_WIDTH)
    w_x = _gauss(v.x / hw, BROW_X_CENTER / hw, BROW_X_WIDTH)
    w_y = _smoothstep(0.0, -0.08, v.y)
    w = w_z * w_x * w_y
    v.y -= BROW_Y_AMP * w


def _apply_temple(v, hh, hw):
    z_norm = v.z / hh
    w_z = _gauss(z_norm, TEMPLE_Z_CENTER, TEMPLE_Z_WIDTH)
    x_abs_norm = abs(v.x) / hw
    w_x = _smoothstep(TEMPLE_X_MIN_ABS, TEMPLE_X_MIN_ABS + 0.20, x_abs_norm)
    w_y = _smoothstep(TEMPLE_Y_MAX, TEMPLE_Y_MAX - 0.10, v.y)
    w = w_z * w_x * w_y
    if abs(v.x) > 1e-6:
        v.x -= math.copysign(TEMPLE_X_AMP * w, v.x)


