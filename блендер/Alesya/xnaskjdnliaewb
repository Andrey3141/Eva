def _slice_widths(verts, num_slices=60):
    if not verts:
        return []

    zs = [v.z for v in verts]
    z_max = max(zs)
    z_min = min(zs)
    z_range = max(z_max - z_min, 1e-6)

    slices = []
    for i in range(num_slices):
        z_top = z_max - (i / num_slices) * z_range
        z_bot = z_max - ((i + 1) / num_slices) * z_range
        band = [v for v in verts if z_bot <= v.z <= z_top]
        if not band:
            continue
        xs = [v.x for v in band]
        slices.append({
            "z_t": (i + 0.5) / num_slices,
            "z_top": z_top,
            "z_bot": z_bot,
            "width": max(xs) - min(xs),
            "x_min": min(xs),
            "x_max": max(xs),
        })
    return slices


def _width_on_ring(verts, ring_i):
    """Ширина (max x − min x) на конкретной параллели."""
    xs = [v.x for v in verts if v.ring_i == ring_i]
    if not xs:
        return 0.0, 0.0, 0.0
    return max(xs) - min(xs), max(xs), min(xs)


def _measure_stage_metrics(verts, num_slices=60):
    if not verts:
        return None

    xs = [v.x for v in verts]
    width = max(xs) - min(xs)
    slices = _slice_widths(verts, num_slices)
    if not slices:
        return None

    w_max = max(s["width"] for s in slices) or 1e-6
    for s in slices:
        s["width_norm"] = s["width"] / w_max

    def width_at(t):
        best = min(slices, key=lambda s: abs(s["z_t"] - t))
        return best["width_norm"]

    peak = max(slices, key=lambda s: s["width"])

    return {
        "crown":     width_at(0.05),
        "forehead":  width_at(0.20),
        "cheekbone": width_at(0.45),
        "jaw":       width_at(0.75),
        "chin":      width_at(0.92),
        "max_t":     peak["z_t"],
        "total":     width,
    }


