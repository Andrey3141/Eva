def _smoothstep(edge0, edge1, x):
    if edge1 == edge0:
        return 0.0 if x < edge0 else 1.0
    t = (x - edge0) / (edge1 - edge0)
    t = max(0.0, min(1.0, t))
    return t * t * (3.0 - 2.0 * t)


def _gauss(z, z_center, z_width):
    if z_width <= 0:
        return 0.0
    d = (z - z_center) / z_width
    return math.exp(-d * d)


def _sample_profile(profile, z_norm):
    if z_norm >= profile[0][0]:
        return profile[0][1]
    if z_norm <= profile[-1][0]:
        return profile[-1][1]
    for i in range(len(profile) - 1):
        z0, v0 = profile[i]
        z1, v1 = profile[i + 1]
        if z1 <= z_norm <= z0:
            t = (z0 - z_norm) / (z0 - z1) if z0 != z1 else 0.0
            t = max(0.0, min(1.0, t))
            t_s = t * t * (3.0 - 2.0 * t)
            return v0 + (v1 - v0) * t_s
    return profile[-1][1]


def _interp_width(z_norm):
    return _sample_profile(WIDTH_PROFILE, z_norm)


def _interp_depth(z_norm):
    return _sample_profile(DEPTH_PROFILE, z_norm)


def _interp_front(z_norm):
    return _sample_profile(FRONT_PROFILE, z_norm)


