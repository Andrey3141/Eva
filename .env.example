# --- Логи ---
EVA_LOG_LEVEL=DEBUG
# EVA_LOG_DIR=/полный/путь/к/логам

# --- LLM ---
# echo | deepseek | gemini | openrouter | router
LLM_PROVIDER=router

# DeepSeek (старый, не удаляем)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Gemini
GEMINI_API_KEY=AQ.Ab8RN6JkvOfF7KMeFGXKL1WxvJ3-Uc4Gxp1g3Vn2RsGBYuXd3g
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenRouter
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=https://localhost/eva
# OPENROUTER_TITLE=EVA

# Router
LLM_ROUTER_COOLDOWN_SEC=30

# --- Ассистент ---
ASSISTANT_NAME=Ассистент
ASSISTANT_ALIASES=Ассистент,Алеся

# --- STT ---
WHISPER_MODEL=small
WHISPER_LANGUAGE=ru

# --- TTS ---
# pyttsx3 | edge | silero
TTS_PROVIDER=silero
TTS_VOICE_HINT=irina
SILERO_SPEAKER=xenia
SILERO_MODEL_PATH=assets/silero/v4_ru.pt

# --- Запись ---
RECORD_SECONDS=5
SAMPLE_RATE=16000

# --- Excel ---
GRADEBOOK_PATH=data/test_gradebook.xlsx

# --- UI ---
UI_ANIMATIONS_ENABLED=true
UI_VOLUME=1.0
UI_SPEECH_RATE=180
UI_DEBUG=false

# --- Avatar ---
AVATAR_DIR=assets/avatar
